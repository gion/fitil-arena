{
  "name": "@fitil/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "cap:sync": "vite build && cap sync",
    "ios": "vite build && cap sync ios && cap open ios",
    "android": "vite build && cap sync android && cap open android",
    "brand": "node scripts/brand.mjs",
    "screens": "SCREENS=1 playwright test e2e/screens.spec.ts",
    "test": "vitest run test",
    "store:shots": "STORE=1 playwright test e2e/store.spec.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@colyseus/sdk": "^0.18.4",
    "@fitil/content": "workspace:*",
    "@fitil/net": "workspace:*",
    "@fitil/sim": "workspace:*",
    "phaser": "~3.90.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.186.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
