{
  "name": "@fitil/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.35",
    "@colyseus/ws-transport": "^0.18.4",
    "@fitil/content": "workspace:*",
    "@fitil/net": "workspace:*",
    "@fitil/sim": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0"
  }
}
