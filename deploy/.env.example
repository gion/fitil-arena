# Copiază în deploy/.env pe server (niciodată în git). Vezi docs/deploy.md.
# Domeniul jocului; DNS: A pentru DOMAIN, www, api și play spre IP-ul serverului
DOMAIN=example.com
# E-mailul pentru Let's Encrypt (avertismente de expirare a certificatelor)
ACME_EMAIL=you@example.com
# Doar litere și cifre (intră într-un URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Câte zile se păstrează backup-urile zilnice din deploy/backups/
BACKUP_KEEP_DAYS=14
# Opționale, intră în build-ul web (goale = nu se trimite nimic / butonul de instalare nu apare)
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
VITE_STORE_IOS=
VITE_STORE_ANDROID=
# Plăți (RevenueCat): antetul Authorization al webhook-ului (de ex. „Bearer <openssl rand -hex 24>”) și cheia secretă REST
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
