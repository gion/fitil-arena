# Server (PORT = jocul Colyseus, API_PORT = API-ul Fastify)
PORT=2567
API_PORT=3000
# Postgres (docker compose: `pnpm db:up`); fără el serverul pornește fără conturi
DATABASE_URL=postgres://fitil:fitil@localhost:5432/fitil
# Baza folosită de testele de integrare (se golește la fiecare rulare!)
TEST_DATABASE_URL=postgres://fitil:fitil@localhost:5432/fitil_test
# Client (Vite expune doar variabilele VITE_*)
# implicit: ws://<host-ul paginii>:2567; pe mobil (Capacitor) trebuie adresa publică wss://
VITE_SERVER_URL=ws://localhost:2567
# Panoul DEV (profiluri de test, data simulată) în build: doar pentru build-uri interne, niciodată în store
VITE_DEV_TOOLS=0
# 1 = build fără meniul Online (demo pe GitHub Pages, fără server)
VITE_OFFLINE_ONLY=
